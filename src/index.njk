---
layout: base.njk
---
<section class="intro" aria-labelledby="intro-title">
  <p class="eyebrow">CAD / Fabrication / Technical documentation</p>
  <h1 id="intro-title">{{ site.intro }}</h1>
  <div class="intro-bottom"><p>{{ site.about }}</p><a class="text-link" href="{{ site.resume }}">View my résumé <span aria-hidden="true">↗</span></a></div>
</section>
<section id="work" aria-labelledby="work-title">
  <div class="section-heading"><h2 id="work-title">Selected work</h2><span class="muted">A closer look at the work</span></div>
  <div class="selected-list">
  {% for project in collections.work | selectFeatured %}
    <article class="selected-project">
      <a class="project-image{% if project.data.imageFit == 'contain' %} contain{% endif %}" href="{{ project.url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ project.data.cover }}" alt="" width="1200" height="900" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
      </a>
      <div class="selected-copy">
        <p class="eyebrow">{{ project.data.category }}</p>
        <h3><a href="{{ project.url }}">{{ project.data.title }}</a></h3>
        <p>{{ project.data.summary }}</p>
        <dl class="contribution"><dt>My contribution</dt><dd>{{ project.data.contribution }}</dd></dl>
        <a class="text-link" href="{{ project.url }}">View project <span aria-hidden="true">↗</span><span class="sr-only">: {{ project.data.title }}</span></a>
      </div>
    </article>
  {% endfor %}
  </div>
</section>
<section class="all-work" aria-labelledby="all-title">
  <div class="section-heading"><h2 id="all-title">Project collection</h2><span class="muted">{{ collections.work | length }} projects</span></div>
  <div class="filters" role="group" aria-label="Filter projects" hidden>
    <button type="button" data-filter="all" aria-pressed="true">All work</button>
    {% for category in collections.categories %}<button type="button" data-filter="{{ category }}" aria-pressed="false">{{ category }}</button>{% endfor %}
  </div>
  <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
  <div class="project-grid">
    {% for project in collections.work %}
    <article class="project-card" data-category="{{ project.data.category }}">
      <a class="card-image{% if project.data.imageFit == 'contain' %} contain{% endif %}" href="{{ project.url }}" tabindex="-1" aria-hidden="true"><img src="{{ project.data.cover }}" alt="" width="800" height="600" loading="lazy" decoding="async"></a>
      <p class="eyebrow">{{ project.data.category }}</p>
      <h3><a href="{{ project.url }}">{{ project.data.title }}</a></h3>
      <p>{{ project.data.summary }}</p>
    </article>
    {% endfor %}
  </div>
</section>
<script src="/scripts/filters.js" defer></script>
