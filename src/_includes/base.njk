<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ summary or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/favicon.ico">
  <link rel="stylesheet" href="/styles/theme.css">
  <link rel="stylesheet" href="/styles/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header container">
    <a class="wordmark" href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>{{ site.name }}</a>
    <nav aria-label="Main navigation">
      <a href="/#work">Work</a>
      <a href="{{ site.resume }}">Résumé <span class="file-label">PDF</span></a>
      <a href="mailto:{{ site.email }}">Contact</a>
    </nav>
  </header>
  <main id="main" class="container">{{ content | safe }}</main>
  <footer class="site-footer container">
    <div><a class="footer-name" href="/">{{ site.name }}</a><p>Have something in mind? <a href="mailto:{{ site.email }}">Let’s talk.</a></p></div>
    <div class="footer-links"><a href="{{ site.github }}">GitHub</a><a href="{{ site.resume }}">Résumé</a><a href="mailto:{{ site.email }}">Email</a><a href="/privacypolicy.html">Privacy</a></div>
    <p class="copyright">© {{ '' | year }} {{ site.name }}</p>
  </footer>
</body>
</html>
